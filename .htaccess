# فعال کردن mod_rewrite
RewriteEngine On

# تنظیم مسیر پایه
RewriteBase /hesabpars/

# اگر فایل یا دایرکتوری وجود نداشت
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ارسال همه درخواست‌ها به index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# جلوگیری از دسترسی به فایل‌های حساس
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# جلوگیری از دسترسی به فایل‌های PHP در پوشه includes
<FilesMatch "\.(php)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# اجازه دسترسی به index.php
<Files "index.php">
    Order Allow,Deny
    Allow from all
</Files>

# تنظیم متغیرهای PHP
php_value display_errors 1
php_value error_reporting E_ALL